{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kelpie",
  "version": "0.0.0",
  "identifier": "pm.shep.kelpie",
  "build": {
    "devUrl": "http://localhost:1520",
    "beforeDevCommand": "pnpm build-reaper && pnpm dev",
    "beforeBuildCommand": "pnpm build-reaper && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kelpie",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/kelpie-reaper"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
